# Torrent Saver environment overrides (all optional).
# Copy to .env and adjust, or set these in your process manager / docker-compose.

# Where the SQLite DB lives (default: ./data/torrents.db)
# TORRENTSAVER_DB=/data/torrents.db

# Standalone server bind (run.sh reads these)
# HOST=127.0.0.1
# PORT=18780
# ROOT_PATH=/torrentsaver        # set empty for a bare standalone deploy

# qBittorrent connection can also be seeded from env on first run.
# These are only used if the corresponding setting/secret is still unset.
# QBIT_URL=http://127.0.0.1:8080
# QBIT_USERNAME=admin
# QBIT_PASSWORD=adminadmin

# Optional shared Claude-stack helpers (auto-detected, safe to leave unset).
# OLLAMA_BROKER_DIR, OBSIDIAN_BASE_URL, etc. — see the Claude stack docs.
